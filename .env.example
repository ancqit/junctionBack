MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_CLUSTER_NAME
MONGODB_DATABASE=junction_dev
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=100
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=5
GCP_IDENTITY_PLATFORM_API_KEY=
PEXELS_API_KEY=
GEMINI_API_KEY=
# Text descriptions (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# Product image generation (default: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PLAN_TRIAL_DAYS=15
PLAN_GRACE_DAYS=15
# Admin access (not in repo). Use any of these in production:
ADMIN_LIST_PATH=admin.json
# Full JSON map for Render/production (preferred when no file is mounted):
# ADMIN_LIST_JSON={"+918340300635":"admin","admin@example.com":"admin"}
# Or single bootstrap admins:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PHONE=+918340300635
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://YOUR_DOMAIN/auth/digilocker/callback
# Terms and conditions (shown in app; override on Render without redeploying code)
# TERMS_AND_CONDITIONS_TITLE=Terms and Conditions
# TERMS_AND_CONDITIONS_VERSION=1.0
# TERMS_AND_CONDITIONS_CONTENT=Your full terms text here...
# Or pass complete JSON:
# TERMS_AND_CONDITIONS_JSON={"title":"Terms and Conditions","version":"1.0","content":"..."}
