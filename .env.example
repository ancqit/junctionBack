MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_CLUSTER_NAME
MONGODB_DATABASE=junction
# Optional: protect POST /internal/jobs/* (plan enforce, waste-archive crawl)
# CRON_SECRET=
# Waste archive crawler (jEarth) — GitHub Action .github/workflows/waste-archive-crawl.yml
#   Cycle: once when crawler code merges to main, then weekly (Sunday 03:00 UTC)
#   Repo secrets: JUNCTIONBACK_URL (e.g. https://junctionback.onrender.com), CRON_SECRET
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=100
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720
OTP_EXPIRE_MINUTES=5
# Cloudflare R2 for shorts media (browser PUT via presign; CDN GET for play)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=junction-shorts
# R2_PUBLIC_BASE_URL=https://media.junction.monster
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_SIGN_EXPIRES_SECONDS=600
# R2_CACHE_CONTROL=public, max-age=31536000, immutable
# Also add a Cloudflare Cache Rule on media.junction.monster for /shorts/* → Cache Everything.
# Cloudflare Stream (optional ABR). Default video upload is R2 PUT — set STREAM_PREFERRED=1
# only when you want Direct Creator Upload → HLS. Stream-first broke some CF proxies.
# STREAM_PREFERRED=0
# STREAM_ACCOUNT_ID=   # defaults to R2_ACCOUNT_ID when unset
# STREAM_API_TOKEN=    # API token with Stream Edit
# STREAM_MAX_DURATION_SECONDS=30
# STREAM_UPLOAD_EXPIRY_SECONDS=600
# STREAM_CUSTOMER_CODE=  # optional — only needed to build URLs before the first ready poll;
#                        # otherwise we store playback.hls from the Stream API (same host for all videos)
# Catalog checkout OTP (junction.today) reuses the same GCP Identity Platform SMS
# as owner login. Add junction.today (and Vercel preview hosts) to Firebase
# Authentication → Settings → Authorized domains for reCAPTCHA.
# Comma-separated browser origins allowed to call the API (CORS).
# Merged with built-in defaults (junction.today / website / Capacitor localhost).
# Setting this no longer drops the defaults.
# CORS_ORIGINS=https://my-preview.vercel.app
# Optional regex (default allows junction.* + *.vercel.app). Set empty to disable.
# CORS_ORIGIN_REGEX=
# Rate limits (slowapi format)
# RATE_LIMIT_AUTH=20/minute
# RATE_LIMIT_AI=30/hour
# RATE_LIMIT_GUEST_ORDERS=30/minute
# RATE_LIMIT_QR=30/minute
# RATE_LIMIT_CATALOG=60/minute
# Public catalog origin encoded into QR posters
# JUNCTION_TODAY_URL=https://junction.today
# Guest session JWT lifetime for junction.today (POST /session)
# SESSION_EXPIRE_SECONDS=900
# Set to false in production to hide /docs and /openapi.json
# OPENAPI_ENABLED=false
# Nominatim geocoding for new city/locality pairs (add-junction + shop create/update)
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=JunctionBackend/1.0 (https://junction.today)
# GEOCODING_COUNTRY_CODES=in
# GEOCODING_TIMEOUT_SECONDS=8
GCP_IDENTITY_PLATFORM_API_KEY=
# Web OTP reCAPTCHA mode for Identity Platform phone auth:
#   classic (default) = { recaptchaToken } only — do not send clientType
#   enterprise = captchaResponse + CLIENT_TYPE_WEB + RECAPTCHA_ENTERPRISE
# GCP_RECAPTCHA_MODE=classic
PEXELS_API_KEY=
PLAN_TRIAL_DAYS=15
# Legacy account grace (shop demotion has NO grace — expire → viewer immediately).
PLAN_GRACE_DAYS=15
# Days a viewer-mode shop stays publicly open before is_open=false (0 = close immediately)
# VIEWER_CLOSE_DAYS=0
# Daily enforce job (Render cron → POST /internal/jobs/enforce-plans with header):
# CRON_SECRET=
# Run the same sweep once when the API process starts (default on). Merge + go-live
# therefore starts with a sweep so existing shops enter the trial→plan loop; set
# ENFORCE_PLANS_ON_STARTUP=0 to skip (local reloads). Daily cron still required.
# ENFORCE_PLANS_ON_STARTUP=1
# Paid shop plans (Starter / Growth / Premium) duration in days (default 365)
# PLAN_YEAR_DAYS=365
# Legacy alias still accepted:
# PLAN_STARTER_DAYS=365
# Admin access (not in repo). Use any of these in production:
ADMIN_LIST_PATH=admin.json
# Full JSON map for Render/production (preferred when no file is mounted):
# ADMIN_LIST_JSON={"+918340300635":"admin","admin@example.com":"admin"}
# Or single bootstrap admins:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PHONE=+918340300635
# DigiLocker / Meri Pehchaan partner credentials (API Setu DigiLocker onboarding).
# Redirect URI must match the DigiLocker partner portal EXACTLY. Prefer:
#   https://www.junction.website/api/auth/digilocker/callback  (Vercel /api proxy)
#   or https://junctionback.onrender.com/auth/digilocker/callback
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://www.junction.website/api/auth/digilocker/callback
DIGILOCKER_SUCCESS_REDIRECT=https://www.junction.website/back-office?digilocker=verified
# Optional overrides (defaults match Meri Pehchaan OpenID Connect / API Setu):
# DIGILOCKER_AUTHORIZE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
# DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/2/token
# DIGILOCKER_USER_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/user
# Terms / Privacy / Customer Addendum (shown on Junction Front Web login).
# Prefer one JSON env on Render — update there without redeploying code:
# TERMS_AND_CONDITIONS_JSON={"title":"Junction Legal","version":"2.0","documents":[{"id":"terms","title":"Terms & Conditions","content":"..."},{"id":"privacy","title":"Privacy Policy","content":"..."},{"id":"addendum","title":"Customer Addendum","content":"..."}]}
# See docs/TERMS_AND_CONDITIONS_JSON.example.json for a full paste-ready copy.
# Legacy flat fields still work:
# TERMS_AND_CONDITIONS_TITLE=Junction Legal
# TERMS_AND_CONDITIONS_VERSION=2.0
# TERMS_AND_CONDITIONS_CONTENT=Your full terms text here...
# Empty content with no documents falls back to built-in Sunskriti / Junction legal pack.
