{
  "name": "Junction Backend",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "./.cursor/scripts/cloud-agent-install.sh",
  "start": "./.cursor/scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "bash -lc 'cd /workspace && source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload'"
    }
  ],
  "ports": [8000]
}
